// Prisma schema — IELTS Control

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Section {
  READING
  LISTENING
  WRITING
  SPEAKING
}

enum QuestionType {
  MCQ
  TRUE_FALSE_NG
  FILL_BLANK
  MATCHING
}

enum WritingTaskType {
  TASK1
  TASK2
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  attempts Attempt[]
}

model NewsPost {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

// One full exam, mirroring the real IELTS structure: a Reading test holds
// 3 passages, a Listening test holds 4 sections. The student takes all
// parts in one sitting for a single band score, so Test.id stays the
// identity referenced by Attempt.refId.
model Test {
  id          String   @id @default(cuid())
  section     Section
  title       String
  description String?
  createdAt   DateTime @default(now())

  parts TestPart[]
}

model TestPart {
  id       String @id @default(cuid())
  testId   String
  part     Int // Reading: 1-3 (passages). Listening: 1-4 (sections).
  title    String?
  // Reading: passage text. Listening: script read aloud via TTS.
  bodyText String

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([testId, part])
}

model Question {
  id            String       @id @default(cuid())
  partId        String
  order         Int
  type          QuestionType
  promptText    String
  options       String? // JSON-encoded array of strings, for MCQ/MATCHING
  correctAnswer String // plain string, or JSON-encoded for MATCHING

  part TestPart @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model WritingTask {
  id        String          @id @default(cuid())
  title     String
  taskType  WritingTaskType
  prompt    String
  // Task 1 only: JSON-encoded chart spec rendered as a real diagram.
  // See ChartSpec in src/lib/chartSpec.ts.
  chartData String?
  minWords  Int             @default(150)
  createdAt DateTime        @default(now())
}

model SpeakingTask {
  id          String   @id @default(cuid())
  title       String
  part        Int // 1, 2, or 3
  promptText  String
  followUps   String? // JSON-encoded array of follow-up questions
  createdAt   DateTime @default(now())
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  section     Section
  refId       String // Test.id, WritingTask.id, or SpeakingTask.id
  refTitle    String
  answers     String? // JSON-encoded user answers/transcript
  rawScore    Int? // correct count, for Reading/Listening
  totalScore  Int? // total questions, for Reading/Listening
  bandScore   Float // 0-9 in 0.5 steps
  aiCriteria  String? // JSON-encoded per-criterion bands, for Writing/Speaking
  aiFeedback  String? // free-text feedback, for Writing/Speaking
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
